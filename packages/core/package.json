{
	"name": "@vetojs/core",
	"version": "1.0.0",
	"description": "Authorization for TypeScript apps and the AI agents working in them. Write a permission once: the same rules answer can(), become a SQL WHERE, check writes field by field, and guard server actions, HTTP handlers and agent tool calls for the person the agent acts for.",
	"keywords": [
		"authorization",
		"permissions",
		"access-control",
		"abac",
		"rbac",
		"rsc",
		"guard",
		"mcp",
		"ai-agents",
		"tool-calling",
		"llm",
		"casl-alternative",
		"typescript"
	],
	"homepage": "https://github.com/ivan-yuldashev/vetojs#readme",
	"bugs": "https://github.com/ivan-yuldashev/vetojs/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ivan-yuldashev/vetojs.git",
		"directory": "packages/core"
	},
	"license": "MIT",
	"author": "Ivan Yuldashev <geekk@ya.ru>",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./guard": {
			"types": "./dist/guard/index.d.ts",
			"default": "./dist/guard/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"prepack": "pnpm build",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@casl/ability": "7.0.1",
		"tsup": "^8.5.1"
	}
}
