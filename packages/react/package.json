{
	"name": "@vetojs/react",
	"version": "1.1.0",
	"description": "Your interface shows what the server will actually allow: <Can>, useCan and useAbility read the same @vetojs rules your handlers, queries and agents are checked against, and a server <Can> decides while rendering.",
	"keywords": [
		"authorization",
		"permissions",
		"access-control",
		"react",
		"rsc",
		"casl-alternative",
		"typescript"
	],
	"homepage": "https://github.com/ivan-yuldashev/vetojs/tree/main/packages/react#readme",
	"bugs": "https://github.com/ivan-yuldashev/vetojs/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ivan-yuldashev/vetojs.git",
		"directory": "packages/react"
	},
	"license": "MIT",
	"author": "Ivan Yuldashev <geekk@ya.ru>",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"prepack": "pnpm build",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@vetojs/core": "^1.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vetojs/core": "workspace:^",
		"jsdom": "^26.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}
