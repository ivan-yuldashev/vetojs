{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"paths": {
			"@vetojs/core": ["./packages/core/src/index.ts"]
		}
	},
	"include": [
		"vitest.alias.ts",
		"vitest.config.ts",
		"packages/**/*.ts",
		"packages/**/*.tsx"
	],
	"exclude": ["node_modules", "**/dist", "**/type-bench"]
}
